APP_NAME="Student Clearance System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app.onrender.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# --------------------------------------------------------
# Logging — use stderr so Render captures logs properly
# --------------------------------------------------------
LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --------------------------------------------------------
# Database
# CI/local: uses SQLite (no server needed)
# Production (Render): uncomment MySQL and set via env vars
# --------------------------------------------------------
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=student_clearance_system
# DB_USERNAME=root
# DB_PASSWORD=

# --------------------------------------------------------
# Session / Cache / Queue — database driver (tables exist via migrations)
# --------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --------------------------------------------------------
# Mail — Gmail SMTP (use App Password, not your real password)
# --------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD="your-gmail-app-password"
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=your-email@gmail.com
MAIL_FROM_NAME="Student Clearance System"
MAIL_TIMEOUT=10

# Alternative HTTP API Mailer for Render Free Tier (bypasses Render SMTP port blocking):
# MAIL_MAILER=resend
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx


# --------------------------------------------------------
# Cron Job Secret — set a long random string, e.g. openssl rand -hex 32
# Used by /cron/approve-all/{secret} and /cron/reject-all/{secret}
# --------------------------------------------------------
CRON_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

VITE_APP_NAME="${APP_NAME}"
